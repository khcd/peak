# Required: comma-separated producer:secret pairs. Every producer is declared in
# the reviewed contract registry; each secret must be at least 16 bytes.
INGEST_KEYS=planar:replace-with-a-long-random-secret

# Reviewed tenant manifests. Add a tenant TOML file and matching INGEST_KEYS entry, then restart.
MANIFEST_DIR=tenants

# Defaults shown explicitly for local development.
BIND_ADDR=127.0.0.1:8081
# Optional path to the checked-in, non-secret service settings.
# CONFIG_PATH=config.json
CLICKHOUSE_URL=http://127.0.0.1:8123
# CLICKHOUSE_DATABASE and CLICKHOUSE_USER drive both the service and docker-compose, which creates
# the ClickHouse account from these same values. Set them explicitly: CLICKHOUSE_USER otherwise
# falls back to `default`, an account the ClickHouse image disables once CLICKHOUSE_USER is set.
# The account is created only on first init of an empty data volume, so changing the name later
# does not rename the existing user -- you must also recreate the volume.
CLICKHOUSE_DATABASE=telemetry
CLICKHOUSE_USER=planar
CLICKHOUSE_PASSWORD=planar123

# Reporting timezone for the dashboard's calendar-day windows (today / 7d / 30d). This belongs to
# the project, not to whoever is looking, so the same window means the same span whether the
# dashboard runs on a laptop or via `docker compose exec`. Any IANA name; UTC matches how
# occurred_at is stored and how the events table is partitioned.
DASHBOARD_TIMEZONE=UTC

MAX_BATCH_EVENTS=200
MAX_BODY_BYTES=1048576
MAX_ATTRIBUTES_BYTES=16384
# Retain delayed offline batches, but reject timestamps that would create bogus partitions.
MAX_EVENT_AGE_DAYS=190
MAX_FUTURE_SKEW_SECONDS=300

# Set true only after the public origin accepts traffic exclusively through Cloudflare
# (for example with Authenticated Origin Pulls or a Cloudflare-only firewall rule).
TRUST_CLOUDFLARE_HEADERS=false
INGEST_VERSION=0.1.0
